{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outlook AI",
  "version": "0.1.0",
  "identifier": "it.esempio.outlookai",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Outlook AI",
        "width": 1728,
        "height": 988,
        "minWidth": 1100,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8080"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}